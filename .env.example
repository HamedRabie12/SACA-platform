# SACA 3.0 — production configuration template
# NEVER commit a real .env file.

NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# PostgreSQL — ONE production source of truth.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/saca?schema=public
# Use DIRECT_URL only when your managed PostgreSQL provider requires a direct connection for migrations.
DIRECT_URL=

# Admin identity/session — no plaintext fallback.
# ADMIN_USERNAME must be a valid email. The runtime, the provisioning
# script, and the AdminMfaFactor all key off User.email = ADMIN_USERNAME.
# Replace this template value with a real admin email before provisioning.
ADMIN_USERNAME=admin@example.example
ADMIN_ROLE=SUPER_ADMIN
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=SACA <noreply@your-domain.example>

# SMS / verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
DEV_OTP_ENABLED=false

# Object storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.example

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_SECRET=

# Redis / rate limit / jobs
REDIS_URL=

# AI / RAG
OPENAI_API_KEY=

# Security / MFA
MFA_ENCRYPTION_KEY=
ELECTION_ENCRYPTION_KEY=

# Upstash Redis (recommended for distributed rate limiting / jobs)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Controlled data operations (keep false in production unless explicitly approved)
ALLOW_CONTROLLED_DATA_OPERATIONS=false
